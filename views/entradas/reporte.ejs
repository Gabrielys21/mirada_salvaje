<%- include('partials/header') %>
<div class="page-head">
  <h1>Entradas</h1>
</div>
<%- include('partials/entradas-tabs') %>

<form class="filters card no-print" method="get" action="/entradas/reporte">
  <label>Desde <input type="date" name="desde" value="<%= filtros.desde %>" required></label>
  <label>Hasta <input type="date" name="hasta" value="<%= filtros.hasta %>" required></label>
  <label>Tipo de entrada
    <select name="tipo_entrada_id">
      <option value="">Todos</option>
      <% tipos.forEach((t) => { %>
        <option value="<%= t.id %>" <%= filtros.tipoEntradaId === t.id ? 'selected' : '' %>><%= t.nombre %></option>
      <% }) %>
    </select>
  </label>
  <div class="filters-actions">
    <button class="btn btn-primary" type="submit">Generar</button>
    <button class="btn" type="submit" name="formato" value="csv">Exportar CSV</button>
    <button class="btn" type="button" data-print>Imprimir</button>
  </div>
</form>

<section class="report">
  <h2>Reporte de ventas del <%= h.fecha(filtros.desde) %> al <%= h.fecha(filtros.hasta) %></h2>

  <div class="stats">
    <div class="stat"><span class="stat-num"><%= h.moneda(totales.ingresos) %></span><span class="stat-label">Ingresos</span></div>
    <div class="stat"><span class="stat-num"><%= totales.boletos %></span><span class="stat-label">Boletos vendidos</span></div>
    <div class="stat"><span class="stat-num"><%= totales.ventas %></span><span class="stat-label">Ventas</span></div>
    <div class="stat"><span class="stat-num"><%= h.moneda(totales.descuentos) %></span><span class="stat-label">Descuentos otorgados</span></div>
    <div class="stat">
      <span class="stat-num"><%= totales.boletos ? h.moneda(totales.ingresos / totales.boletos) : '—' %></span>
      <span class="stat-label">Ingreso promedio por boleto</span>
    </div>
  </div>

  <% if (!totales.ventas) { %>
    <p class="empty">No hay ventas en ese periodo.</p>
  <% } else { %>
  <% const tabla = (filas, titulo) => { %>
    <div class="table-wrap">
    <table class="table">
      <thead><tr><th><%= titulo %></th><th class="num">Ventas</th><th class="num">Boletos</th><th class="num">Descuentos</th><th class="num">Ingresos</th><th class="num">% del total</th></tr></thead>
      <tbody>
      <% filas.forEach((f) => { %>
        <tr>
          <td><%= f.etiqueta %></td>
          <td class="num"><%= f.ventas %></td>
          <td class="num"><%= f.boletos %></td>
          <td class="num"><%= h.moneda(f.descuentos) %></td>
          <td class="num"><strong><%= h.moneda(f.ingresos) %></strong></td>
          <td class="num"><%= totales.ingresos > 0 ? Math.round((f.ingresos / totales.ingresos) * 1000) / 10 : 0 %>%</td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>

  <h3>Por tipo de entrada</h3>
  <% tabla(porTipo.map((f) => ({ ...f, etiqueta: f.nombre })), 'Tipo de entrada') %>

  <h3>Por promoción</h3>
  <% tabla(porPromocion.map((f) => ({ ...f, etiqueta: f.nombre })), 'Promoción') %>

  <h3>Por día</h3>
  <% tabla(porDia.map((f) => ({ ...f, etiqueta: h.fecha(f.dia) })), 'Día') %>
  <% } %>
  <p class="muted no-print">Promociones vigentes hoy: <%= promocionesVigentes %>. El CSV incluye el detalle de cada venta.</p>
</section>
<%- include('partials/footer') %>
