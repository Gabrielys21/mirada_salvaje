# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Cadena de conexión de PostgreSQL (postgresql://usuario:contraseña@host:puerto/base)
DATABASE_URL=

# Cadena larga y aleatoria para firmar las cookies de sesión.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Puerto HTTP (Render lo asigna automáticamente)
PORT=3000

# Opcional: true/false para forzar SSL en la conexión a la base.
# Si se deja vacío: sin SSL para localhost, con SSL para cualquier otro host.
DATABASE_SSL=

# Administrador inicial: solo se usa si la tabla usuarios está vacía.
# Tras el primer arranque puedes borrar ADMIN_PASSWORD.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
